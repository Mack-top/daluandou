# ---- 服务 ----
# 后端监听端口（前端 Vite 通过 /api 代理到这里）
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# ---- 数据库 ----
# SQLite 数据库文件路径，相对 backend/ 目录
DATABASE_PATH=./data/game.db

# ---- 跨域 ----
# 允许携带凭证访问的来源，多个用逗号分隔
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# ---- 会话 ----
# 游客令牌有效期（小时）
SESSION_TTL_HOURS=720

# 支付回调 HMAC 签名密钥（生产必须设置至少 32 字符的随机密钥，不可使用示例值）
PAYMENT_SECRET=dev-only-payment-secret

# ---- GM 后台（v11）----
# GM 管理端点允许的来源 IP 白名单（逗号分隔）
GM_IP_ALLOWLIST=127.0.0.1,::1
# GM 会话时长（小时）
GM_SESSION_TTL_HOURS=8
# 登录失败上限与锁定窗口（分钟）
GM_LOGIN_MAX_FAILURES=5
GM_LOGIN_LOCK_MINUTES=15
# 种子 GM 账号：用户名可配，口令必须显式提供（未配置则 seed 跳过建号，绝不硬编码）
GM_SEED_USERNAME=gm-admin
# GM_SEED_PASSWORD=请在部署时显式配置强口令

# ---- 分服状态（v16 按服隔离）----
# 维护中的服务器编号（逗号分隔）；维护中的服在选服界面禁用
SERVERS_MAINTENANCE=8
# 分服热度阈值：玩家数达到该值标记为「热闹」
SERVER_BUSY_THRESHOLD=50
