{
  "name": "food-fantasy",
  "private": true,
  "version": "0.1.0",
  "description": "美食大乱斗 · 前后端分离工程（frontend / backend）",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm --workspace frontend run dev",
    "dev:api": "npm --workspace backend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:seed": "npm --workspace backend run db:seed",
    "db:reset": "npm --workspace backend run db:reset",
    "smoke": "npm --workspace backend run smoke",
    "live-check": "npm --workspace backend run live-check",
    "test": "npm --workspace backend run test",
    "typecheck": "npm --workspace backend run typecheck && npm --workspace frontend run typecheck",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
